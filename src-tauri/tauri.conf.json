{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "walkplay-eq",
  "version": "0.2.0",
  "identifier": "com.akira.walkplay-eq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Walkplay EQ",
        "create": false,
        "visible": false,
        "center": true,
        "width": 1200,
        "height": 780,
        "minWidth": 1120,
        "minHeight": 690,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
